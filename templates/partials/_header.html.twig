<header class="app-header bg-white border-bottom px-3 px-md-4 py-2">
    <div class="app-content d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2 gap-md-3">
            <button class="btn btn-sm btn-outline-secondary d-none d-lg-inline-flex" type="button" id="sidebarToggle" aria-controls="appSidebar" aria-expanded="true" aria-label="Hide navigation" title="Hide navigation">
                <i class="fa-solid fa-table-columns" aria-hidden="true"></i>
            </button>
            <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
            <a class="header-brand" href="{{ path('app_dashboard') }}" aria-label="YOCOR Express home">
                <img src="{{ asset('brand/yocor-logo.svg') }}" alt="YOCOR Express">
            </a>
            <span class="text-secondary small d-none d-md-inline">{{ is_granted('ROLE_ADMIN') ? 'Administration' : 'Staff workspace' }}</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="small text-end d-none d-sm-inline lh-sm">
                <strong class="d-block text-dark">{{ app.user.name }}</strong>
                <span class="text-secondary">{{ is_granted('ROLE_ADMIN') ? 'Administrator' : 'Staff' }}</span>
            </span>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-right-from-bracket me-1" aria-hidden="true"></i><span class="d-none d-sm-inline">Logout</span></button>
            </form>
        </div>
    </div>
</header>
