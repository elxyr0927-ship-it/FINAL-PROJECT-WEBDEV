{% extends 'base.html.twig' %}

{% block title %}{{ heading }} | YOCOR Express{% endblock %}

{% block body %}
    <div class="form-shell">
        <div class="mb-3">
            <a class="link-secondary small" href="{{ path('admin_users_index') }}">&larr; Back to accounts</a>
            <h1 class="brand-text mt-2 mb-1">{{ heading }}</h1>
            <p class="text-secondary mb-0">Only administrators can manage account roles and status.</p>
        </div>

        <div class="card">
            <div class="card-body p-3 p-lg-4">
                {{ include('admin/users/_form.html.twig', {'form': form}) }}
            </div>
        </div>
    </div>
{% endblock %}
