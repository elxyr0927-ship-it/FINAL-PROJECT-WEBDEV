{% extends 'base.html.twig' %}

{% block title %}Edit Service{% endblock %}

{% block body %}
    <div class="form-shell">
        <div class="mb-3">
            <a class="small" href="{{ path('admin_services_index') }}">&larr; Back to services</a>
            <h1 class="mt-2 mb-1">Edit service</h1>
            <p class="text-muted mb-0">Update the service details and pricing.</p>
        </div>
        <div class="card">
            <div class="card-body p-3 p-lg-4">
                {{ include('admin/services/_form.html.twig', {'button_label': 'Save changes', 'cancel_path': path('admin_services_index')}) }}
            </div>
        </div>
        <div class="form-actions">
            {{ include('admin/services/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
