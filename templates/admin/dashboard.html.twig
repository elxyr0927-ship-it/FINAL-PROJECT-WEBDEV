{% extends 'base.html.twig' %}

{% block title %}Admin dashboard{% endblock %}

{% block body %}
    <div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
        <div>
            <span class="text-uppercase small fw-bold brand-accent">Operations overview</span>
            <h1 class="mt-1 mb-1">Dashboard</h1>
            <p class="text-muted mb-0">A quick view of your shipments, accounts, and services.</p>
        </div>
        <a class="btn btn-brand" href="{{ path('admin_bookings_new') }}"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>Create shipment</a>
    </div>

    <section class="mb-4" aria-labelledby="keyFiguresHeading">
        <h2 class="h6 text-uppercase text-secondary fw-bold mb-2" id="keyFiguresHeading">Key figures</h2>
        <div class="dashboard-grid">
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Total users</div><div class="metric-value my-2">{{ user_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_users_index') }}">Manage accounts <span aria-hidden="true">&rarr;</span></a>
            </div></div>
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Total staff</div><div class="metric-value my-2">{{ staff_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_users_index') }}">Manage staff <span aria-hidden="true">&rarr;</span></a>
            </div></div>
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Total records</div><div class="metric-value my-2">{{ booking_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_bookings_index') }}">View all shipments <span aria-hidden="true">&rarr;</span></a>
            </div></div>
        </div>
    </section>

    <section class="mb-4" aria-labelledby="operationsHeading">
        <h2 class="h6 text-uppercase text-secondary fw-bold mb-2" id="operationsHeading">Operations</h2>
        <div class="dashboard-grid">
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Pending shipments</div><div class="metric-value my-2">{{ pending_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_bookings_index', {status: 'pending'}) }}">Review pending <span aria-hidden="true">&rarr;</span></a>
            </div></div>
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Unpaid shipments</div><div class="metric-value my-2">{{ unpaid_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_bookings_index', {payment: 'unpaid'}) }}">Review payments <span aria-hidden="true">&rarr;</span></a>
            </div></div>
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Services</div><div class="metric-value my-2">{{ service_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_services_index') }}">Manage services <span aria-hidden="true">&rarr;</span></a>
            </div></div>
            <div class="card metric-card"><div class="card-body d-flex flex-column">
                <div class="small text-muted fw-semibold">Unread inquiries</div><div class="metric-value my-2">{{ unread_inquiry_count }}</div>
                <a class="small mt-auto text-decoration-none fw-semibold" href="{{ path('admin_inquiries_index', {filter: 'unread'}) }}">Review inquiries <span aria-hidden="true">&rarr;</span></a>
            </div></div>
        </div>
    </section>

    <section class="card overflow-hidden">
        <div class="card-header bg-white d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 p-2 p-md-3">
            <div><h2 class="h5 mb-1">Recent shipments</h2><p class="small text-muted mb-0">Latest records across your operation.</p></div>
            <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_bookings_index') }}">View all shipments</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Tracking</th><th>Customer</th><th>Service</th><th>Status</th><th>Encoded by</th><th>Created</th></tr></thead>
                <tbody>
                {% for booking in recent_bookings %}
                    <tr>
                        <td><a href="{{ path('admin_bookings_show', {id: booking.id}) }}"><code>{{ booking.trackingCode }}</code></a></td>
                        <td>{{ booking.customerName }}</td>
                        <td>{{ booking.service.name }}</td>
                        <td>{{ booking.status|capitalize }}</td>
                        <td>
                            {% if booking.createdBy %}
                                {% set creator_roles = booking.createdBy.roles %}
                                {{ booking.createdBy.name }}
                                <div class="small text-muted">{{ 'ROLE_ADMIN' in creator_roles ? 'Administrator' : ('ROLE_STAFF' in creator_roles ? 'Staff' : 'User') }}</div>
                            {% else %}
                                <span class="text-muted">System</span>
                            {% endif %}
                        </td>
                        <td>{{ booking.createdAt|date('M j, Y') }}</td>
                    </tr>
                {% else %}
                    <tr><td class="text-center text-muted py-4" colspan="6">No shipments found.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
