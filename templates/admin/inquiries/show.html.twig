{% extends 'base.html.twig' %}

{% block title %}Inquiry {{ inquiry.id }}{% endblock %}

{% block body %}
    <div class="detail-shell">
        <div class="mb-4">
            <a class="small" href="{{ path('admin_inquiries_index', inquiry.deletedAt ? {filter: 'archived'} : {}) }}">&larr; Back to inquiries</a>
            <h1 class="mt-2 mb-1">{{ inquiry.subject }}</h1>
            <p class="text-muted mb-0">Received {{ inquiry.createdAt|date('M j, Y H:i') }}{% if inquiry.deletedAt %} &middot; Archived {{ inquiry.deletedAt|date('M j, Y H:i') }}{% endif %}</p>
        </div>
        {% if inquiry.deletedAt %}
            <div class="alert alert-secondary d-flex flex-wrap justify-content-between align-items-center gap-2" role="status">
                <span>This inquiry is archived and hidden from the active inbox.</span>
                <div class="d-flex flex-wrap gap-2">
                    <form method="post" action="{{ path('admin_inquiries_action', {id: inquiry.id, action: 'restore'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('inquiry_restore' ~ inquiry.id) }}">
                        <button class="btn btn-sm btn-outline-primary">Restore inquiry</button>
                    </form>
                    <form method="post" action="{{ path('admin_inquiries_action', {id: inquiry.id, action: 'delete'}) }}" data-confirm="Permanently delete this inquiry? This cannot be undone.">
                        <input type="hidden" name="_token" value="{{ csrf_token('inquiry_delete' ~ inquiry.id) }}">
                        <button class="btn btn-sm btn-outline-danger">Delete permanently</button>
                    </form>
                </div>
            </div>
        {% endif %}
        <div class="card">
            <div class="card-header bg-white d-flex flex-wrap justify-content-between gap-2">
                <span class="fw-semibold">{{ inquiry.name }}</span>
                <span class="text-muted small">{{ inquiry.email }}</span>
            </div>
            <div class="card-body">
                <p class="mb-0 prose-measure" style="white-space: pre-wrap">{{ inquiry.message }}</p>
            </div>
            {% if not inquiry.deletedAt %}
                <div class="card-footer bg-white d-flex flex-wrap gap-2">
                    {% set action = inquiry.isRead ? 'unread' : 'read' %}
                    <form method="post" action="{{ path('admin_inquiries_action', {id: inquiry.id, action: action}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('inquiry_' ~ action ~ inquiry.id) }}">
                        <button class="btn btn-sm btn-outline-primary">{{ inquiry.isRead ? 'Mark unread' : 'Mark read' }}</button>
                    </form>
                    <form method="post" action="{{ path('admin_inquiries_action', {id: inquiry.id, action: 'archive'}) }}" data-confirm="Archive this inquiry?" data-confirm-title="Archive inquiry" data-confirm-button="Archive">
                        <input type="hidden" name="_token" value="{{ csrf_token('inquiry_archive' ~ inquiry.id) }}">
                        <button class="btn btn-sm btn-outline-danger">Archive</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
