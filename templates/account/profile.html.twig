{% extends 'base.html.twig' %}

{% import 'partials/_form_helpers.html.twig' as form_helpers %}

{% block title %}My profile | YOCOR Express{% endblock %}

{% block body %}
    <div class="form-shell">
        <div class="mb-3">
            <h1 class="brand-text mb-1">My profile</h1>
            <p class="text-secondary mb-0">Review and update your account details.</p>
        </div>
        {{ form_helpers.errorSummary(form) }}
        <div class="card">
            <div class="card-body p-3 p-lg-4">
                {{ form_start(form) }}
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(form.name) }}</div>
                        <div class="col-md-6">{{ form_row(form.username) }}</div>
                        <div class="col-12">{{ form_row(form.email) }}</div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-brand" type="submit">Save profile</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
