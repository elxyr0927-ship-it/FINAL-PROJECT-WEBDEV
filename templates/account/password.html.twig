{% extends 'base.html.twig' %}

{% import 'partials/_form_helpers.html.twig' as form_helpers %}

{% block title %}Change password | YOCOR Express{% endblock %}

{% block body %}
    <div class="form-shell">
        <div class="mb-3">
            <h1 class="brand-text mb-1">Change password</h1>
            <p class="text-secondary mb-0">Confirm your current password before setting a new one.</p>
        </div>
        {{ form_helpers.errorSummary(form) }}
        <div class="card">
            <div class="card-body p-3 p-lg-4">
                {{ form_start(form) }}
                    {{ form_row(form.currentPassword) }}
                    {{ form_row(form.newPassword) }}
                    <div class="form-actions">
                        <button class="btn btn-brand" type="submit">Update password</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
