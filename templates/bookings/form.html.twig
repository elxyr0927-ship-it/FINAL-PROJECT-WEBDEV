{% extends 'base.html.twig' %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
    <div class="form-shell">
        <div class="mb-3">
            <h1 class="mb-1">{{ heading }}</h1>
            <p class="text-muted mb-0">Customer details, service, and route information.</p>
        </div>
        <div class="card">
            <div class="card-body p-3 p-lg-4">
                {{ include('bookings/_form.html.twig', {
                    'form': form,
                    'back_route': back_route,
                    'back_parameters': back_parameters|default({})
                }) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'bookings/_form_script.html.twig' %}
{% endblock %}
